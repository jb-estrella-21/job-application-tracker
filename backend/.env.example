# Copy this file to `.env` and replace placeholders with real secret values.
# PostgreSQL connection strings are secrets. Never commit them.
# Requires PostgreSQL >= 15.

# Runtime connection for the NestJS application. Production uses Neon’s pooled
# connection URL; it is not used by Prisma CLI migration commands.
DATABASE_URL=
# Prisma CLI and migration connection. Production uses Neon’s direct connection
# URL. Keep this out of the Vercel runtime environment when migrations run separately.
DIRECT_URL=
NODE_ENV=development
# Generate a cryptographically random secret of at least 32 bytes. Do not use this file's values in production.
JWT_SECRET=
JWT_ISSUER=job-app-tracker-api
JWT_AUDIENCE=job-app-tracker-web
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
# Comma-separated browser origins allowed to call the API.
# Production must use exact HTTPS frontend origin(s), for example https://app.example.com.
CORS_ORIGINS=http://localhost:5173
REFRESH_SESSION_EXPIRES_IN=30d
# Set to true in production; production validation rejects false.
REFRESH_COOKIE_SECURE=false
